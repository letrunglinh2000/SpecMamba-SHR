    , "test": {
      "name": "test_dataset"
      , "dataset_type": "spec"
      , "dataroot_H": "/data2/letrunglinh/despecular/diff-train-style/SHDR-E2E-SHDNet/trainsets/SHIQ/Test/Out/"
